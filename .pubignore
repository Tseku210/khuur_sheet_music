# pub reads this file instead of .gitignore in this folder, so it repeats
# .gitignore and then leaves out what pub.dev does not need.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/

# Generated by Flutter tooling
.flutter-plugins
.flutter-plugins-dependencies

# Kept on the maintainer's machine. CLAUDE.md is the one agent file in git.
/.claude/
/.mcp.json
/docs/
skills-lock.json

# Not part of the khuur_sheet_music package
/.github/
/CLAUDE.md
